{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghost-bus-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "8c6fafe89fca4db5a8330ef5311ade58",
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "HISTORY_DB",
      "database_name": "ghost-bus-history",
      "database_id": "e8aec674-36d4-402c-a111-6de0c149ab10"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOT_BUCKET",
      "bucket_name": "ghost-bus-snapshots"
    }
  ],
  "vars": {
    "AGENCY_NAME": "Metro Transit (Twin Cities)",
    "CITY_NAME": "Minneapolis–Saint Paul, MN",
    "TRANSIT_SYSTEM": "Metro Transit",
    "REGION_NAME": "Twin Cities Metropolitan Area, Minnesota"
  }
}
